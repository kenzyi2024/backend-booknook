# --- Server ---
PORT=5001

# --- Database ---
MONGO_URI=your-mongodb-connection-string

# --- Auth (REQUIRED) ---
# Secret used to sign JWT session tokens. Use a long random string and keep it private.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# --- Google Sign-In ---
# Create an OAuth 2.0 Client ID (Web) in Google Cloud → APIs & Services → Credentials.
# Use the SAME client id in the frontend as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- AI (Groq by default; any OpenAI-compatible provider works) ---
# Get a free key at https://console.groq.com/keys
AI_API_KEY=your-groq-api-key
AI_MODEL=llama-3.3-70b-versatile
# Change AI_BASE_URL to switch providers (OpenAI, OpenRouter, Ollama, etc.)
# AI_BASE_URL=https://api.groq.com/openai/v1

# --- CORS (optional) ---
# Leave unset in dev (allows all origins). In production set your frontend URL(s),
# comma-separated, e.g. https://booknook.vercel.app
# CLIENT_URL=http://localhost:5173
